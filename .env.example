# --- Application ---
APP_ENV=development
SECRET_KEY=syndic-ms-dev-secret-key-change-in-production
REQUIRE_STRONG_SECRET=false

# --- Database ---
# Leave unset for the local SQLite file at backend/instance/syndic_ms.db.
# Production example: mysql://user:password@host:3306/syndic_ms
# DATABASE_URL=

# --- Sessions and CSRF ---
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
CSRF_ENABLED=true
PERMANENT_SESSION_LIFETIME_SECONDS=86400

# --- CORS (Next.js dev origins) ---
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# --- Frontend -> backend proxy ---
API_INTERNAL_URL=http://127.0.0.1:5000

# --- Platform defaults ---
PLATFORM_NAME=SyndicMS
PLATFORM_CURRENCY=MUR
PLATFORM_VAT_RATE=15
BUSINESS_TIMEZONE=Indian/Mauritius
