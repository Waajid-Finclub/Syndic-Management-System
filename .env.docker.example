# Full-stack Docker Compose template for docker-compose.yml.
# This starts its own MySQL container. For EasyPanel-managed MySQL, use .env.easypanel.example.
# Do not commit real production secrets.

APP_PUBLIC_URL=https://your-domain.example
FRONTEND_PORT=3000

SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
MYSQL_DATABASE=syndic_ms
MYSQL_USER=syndic
MYSQL_PASSWORD=replace-with-a-strong-db-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password

SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
PAYMENT_GATEWAY=simulated
API_PROXY_DEBUG=false
API_REQUEST_DEBUG=false
